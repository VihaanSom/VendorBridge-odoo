generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OFFICER
  VENDOR
  APPROVER

  @@map("user_role")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("vendor_status")
}

enum RfqStatus {
  DRAFT
  ACTIVE
  CLOSED
  AWARDED

  @@map("rfq_status")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED

  @@map("quotation_status")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum PoStatus {
  ISSUED
  ACKNOWLEDGED
  FULFILLED
  CANCELLED

  @@map("po_status")
}

enum InvoiceStatus {
  GENERATED
  SENT
  PAID
  VOID

  @@map("invoice_status")
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  email                 String               @unique @db.VarChar(255)
  passwordHash          String               @map("password_hash") @db.VarChar(255)
  role                  UserRole
  firstName             String?              @map("first_name") @db.VarChar(100)
  lastName              String?              @map("last_name") @db.VarChar(100)
  isActive              Boolean              @default(true) @map("is_active")
  createdAt             DateTime?            @default(now()) @map("created_at") @db.Timestamp()
  updatedAt             DateTime?            @updatedAt @map("updated_at") @db.Timestamp()

  passwordResetTokens   PasswordResetToken[]
  vendorProfile         VendorProfile?
  createdRfqs           Rfq[]                @relation("CreatedRfqs")
  approvals             Approval[]           @relation("ApproverApprovals")
  issuedPurchaseOrders  PurchaseOrder[]      @relation("IssuedPOs")
  activityLogs          ActivityLog[]        @relation("UserActivityLogs")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp()
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp()

  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model VendorProfile {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  companyName  String       @map("company_name") @db.VarChar(255)
  gstNumber    String       @unique @map("gst_number") @db.VarChar(15)
  contactPhone String?      @map("contact_phone") @db.VarChar(20)
  category     String       @db.VarChar(100)
  vendorStatus VendorStatus @default(ACTIVE) @map("vendor_status")
  rating       Decimal?     @db.Decimal(3, 2)

  user         User         @relation(fields: [userId], references: [id])
  rfqInvites   RfqVendorInvite[]
  quotations   Quotation[]

  @@map("vendor_profiles")
}

model Rfq {
  id            String    @id @default(uuid()) @db.Uuid
  createdBy     String    @map("created_by") @db.Uuid
  title         String    @db.VarChar(255)
  deadline      DateTime  @db.Timestamp()
  status        RfqStatus @default(DRAFT)
  attachmentUrl String?   @map("attachment_url") @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp()

  creator       User              @relation("CreatedRfqs", fields: [createdBy], references: [id])
  items         RfqItem[]
  vendorInvites RfqVendorInvite[]
  quotations    Quotation[]

  @@map("rfqs")
}

model RfqItem {
  id            String  @id @default(uuid()) @db.Uuid
  rfqId         String  @map("rfq_id") @db.Uuid
  itemName      String  @map("item_name") @db.VarChar(255)
  description   String? @db.Text
  quantity      Int
  unitOfMeasure String  @map("unit_of_measure") @db.VarChar(50)

  rfq           Rfq     @relation(fields: [rfqId], references: [id])
  quotationItems QuotationItem[]

  @@map("rfq_items")
}

model RfqVendorInvite {
  rfqId     String    @map("rfq_id") @db.Uuid
  vendorId  String    @map("vendor_id") @db.Uuid
  invitedAt DateTime? @default(now()) @map("invited_at") @db.Timestamp()

  rfq       Rfq           @relation(fields: [rfqId], references: [id])
  vendor    VendorProfile @relation(fields: [vendorId], references: [id])

  @@id([rfqId, vendorId])
  @@map("rfq_vendor_invites")
}

model Quotation {
  id                   String          @id @default(uuid()) @db.Uuid
  rfqId                String          @map("rfq_id") @db.Uuid
  vendorId             String          @map("vendor_id") @db.Uuid
  deliveryTimelineDays Int             @map("delivery_timeline_days")
  notes                String?         @db.Text
  status               QuotationStatus @default(DRAFT)
  submittedAt          DateTime?       @default(now()) @map("submitted_at") @db.Timestamp()

  rfq                  Rfq             @relation(fields: [rfqId], references: [id])
  vendor               VendorProfile   @relation(fields: [vendorId], references: [id])
  items                QuotationItem[]
  approvals            Approval[]
  purchaseOrders       PurchaseOrder[]

  @@unique([rfqId, vendorId])
  @@map("quotations")
}

model QuotationItem {
  id           String  @id @default(uuid()) @db.Uuid
  quotationId  String  @map("quotation_id") @db.Uuid
  rfqItemId    String  @map("rfq_item_id") @db.Uuid
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)

  quotation    Quotation @relation(fields: [quotationId], references: [id])
  rfqItem      RfqItem   @relation(fields: [rfqItemId], references: [id])

  @@unique([quotationId, rfqItemId])
  @@map("quotation_items")
}

model Approval {
  id             String         @id @default(uuid()) @db.Uuid
  quotationId    String         @map("quotation_id") @db.Uuid
  approverId     String         @map("approver_id") @db.Uuid
  previousStatus String?        @map("previous_status") @db.VarChar(50)
  status         ApprovalStatus @default(PENDING)
  remarks        String?        @db.Text
  actedAt        DateTime?      @map("acted_at") @db.Timestamp()

  quotation      Quotation      @relation(fields: [quotationId], references: [id])
  approver       User           @relation("ApproverApprovals", fields: [approverId], references: [id])

  @@map("approvals")
}

model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  poNumber     String    @unique @map("po_number") @db.VarChar(100)
  quotationId  String    @map("quotation_id") @db.Uuid
  issuedBy     String    @map("issued_by") @db.Uuid
  status       PoStatus  @default(ISSUED)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp()

  quotation    Quotation @relation(fields: [quotationId], references: [id])
  issuer       User      @relation("IssuedPOs", fields: [issuedBy], references: [id])
  invoices     Invoice[]

  @@map("purchase_orders")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(100)
  poId          String        @map("po_id") @db.Uuid
  subtotal      Decimal       @db.Decimal(12, 2)
  taxPercentage Decimal       @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount     Decimal       @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  status        InvoiceStatus @default(GENERATED)
  emailedAt     DateTime?     @map("emailed_at") @db.Timestamp()
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamp()

  po            PurchaseOrder @relation(fields: [poId], references: [id])

  @@map("invoices")
}

model ActivityLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  action      String    @db.VarChar(255)
  entityType  String    @map("entity_type") @db.VarChar(100)
  entityId    String    @map("entity_id") @db.Uuid
  description String?   @db.Text
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp()

  user        User?     @relation("UserActivityLogs", fields: [userId], references: [id])

  @@map("activity_logs")
}
